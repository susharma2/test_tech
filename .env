# ============================================
# VERIFCORE REGISTRATION SYSTEM
# Environment Variables Template
# ============================================
# IMPORTANT: Copy this to .env and never commit .env to GitHub!
# This file lists all required environment variables for production.

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_FILE=registrations.db
DB_BACKUP_PATH=/backups/registrations

# ============================================
# ADMIN AUTHENTICATION
# ============================================
# CHANGE THESE FOR PRODUCTION! Use strong, random values.
# Generate with: openssl rand -base64 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_32_CHARS_MIN

# JWT Secret for session tokens (optional, for enhanced security)
JWT_SECRET=CHANGE_ME_TO_STRONG_SECRET_KEY_64_CHARS_MIN

# ============================================
# EMAIL CONFIGURATION (SMTP for verification)
# ============================================
ENABLE_EMAIL_VERIFICATION=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Email sender address and admin notification
EMAIL_FROM=noreply@verifcore.com
ADMIN_EMAIL=admin@verifcore.com
NOTIFICATION_EMAIL=admin@verifcore.com

# Email verification token expiry (in minutes)
EMAIL_VERIFICATION_EXPIRY=24

# ============================================
# RECAPTCHA CONFIGURATION (Spam Prevention)
# ============================================
ENABLE_RECAPTCHA=true
RECAPTCHA_SITE_KEY=6LcTQ....your-recaptcha-site-key-here
RECAPTCHA_SECRET_KEY=6LcTQ....your-recaptcha-secret-key-here
RECAPTCHA_SCORE_THRESHOLD=0.5

# Get keys from: https://www.google.com/recaptcha/admin
# Use reCAPTCHA v3 for best user experience

# ============================================
# RATE LIMITING & SECURITY
# ============================================
# Rate limiting (requests per minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_STORE=memory

# Temporary IP ban after multiple failures (minutes)
TEMP_BAN_DURATION=30
MAX_LOGIN_ATTEMPTS=5

# Session configuration
SESSION_TIMEOUT_MINUTES=30
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_RANDOM_STRING

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com
CORS_CREDENTIALS=true

# ============================================
# SECURITY HEADERS (Helmet.js)
# ============================================
ENABLE_HELMET=true
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000

# Content Security Policy
CSP_ENABLED=true
CSP_SCRIPT_SRC=self

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info
LOG_FILE=logs/server.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d

# Request logging
ENABLE_REQUEST_LOGGING=true
LOG_SENSITIVE_DATA=false

# ============================================
# DATABASE SECURITY
# ============================================
# Enable encrypted backups
DB_ENCRYPTION_ENABLED=true
DB_ENCRYPTION_KEY=CHANGE_ME_DATABASE_ENCRYPTION_KEY

# Auto backup interval (in hours)
AUTO_BACKUP_INTERVAL=24

# ============================================
# AUDIT & COMPLIANCE
# ============================================
# Enable audit logging for admin actions
ENABLE_AUDIT_LOG=true
AUDIT_LOG_FILE=logs/audit.log

# Data retention (in days)
DATA_RETENTION_DAYS=365

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_EMAIL_VERIFICATION=true
FEATURE_RECAPTCHA=true
FEATURE_EXPORT_DATA=true
FEATURE_DELETE_DATA=true
FEATURE_API_DOCUMENTATION=false

# ============================================
# THIRD-PARTY SERVICES
# ============================================
# Sentry for error tracking (optional)
SENTRY_DSN=

# DataDog or similar APM (optional)
APM_ENABLED=false
APM_SERVICE_NAME=verifcore-registration

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Only use these in development!
DEBUG_MODE=false
ALLOW_UNVERIFIED_REGISTRATIONS=false
SKIP_RECAPTCHA_IN_DEV=false

# ============================================
# IMPORTANT SECURITY NOTES
# ============================================
# 1. Never commit .env file to version control
# 2. Use strong, unique passwords (min 32 characters)
# 3. Rotate secrets regularly
# 4. Use environment-specific values for prod/staging/dev
# 5. Enable HTTPS in production (NODE_ENV=production)
# 6. Set secure CORS_ORIGIN for your domain only
# 7. Keep dependencies updated: npm audit fix
# 8. Enable reCAPTCHA for spam prevention
# 9. Enable email verification for valid emails
# 10. Monitor logs regularly for suspicious activity
