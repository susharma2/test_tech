{
  "name": "verifcore-registration-system",
  "version": "2.0.0",
  "description": "Secure user registration system with email verification, reCAPTCHA, rate limiting, and admin panel",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node server-enhanced.js",
    "test": "jest --detectOpenHandles",
    "test:security": "npm audit && npm run lint",
    "lint": "eslint .",
    "migrate": "node scripts/migrate-db.js",
    "backup": "node scripts/backup-db.js",
    "audit": "npm audit --audit-level=moderate"
  },
  "keywords": [
    "registration",
    "email-verification",
    "recaptcha",
    "rate-limiting",
    "security",
    "express",
    "sqlite"
  ],
  "author": "Verifcore",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "crypto-random-string": "^5.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.1.2",
    "nodemailer": "^6.9.7",
    "sanitize-html": "^2.12.0",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "optionalDependencies": {
    "bcryptjs": "^2.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/susharma2/test_tech.git"
  },
  "bugs": {
    "url": "https://github.com/susharma2/test_tech/issues"
  },
  "homepage": "https://github.com/susharma2/test_tech#readme"
}
